# Папки сборки (игнорируем полностью, вместе со всем содержимым)
build/
out/
Debug/
Release/
x64/
x86/

# Сгенерированные ANTLR файлы (пересоздаются при сборке)
generated/
__antlr_generated/

# Временные файлы VS
.vs/
*.user
*.suo
*.sdf
*.opendb
*.VC.db
*.VC.VC.opendb

# Игнорируем временные объектные файлы (они появляются в папках сборки, но те уже игнорируются)
*.obj
*.o

# Игнорируем только те exe и dll, которые могут случайно появиться в корне (например, при тестах), но оставляем те, что лежат в подпапках типа ANTLR/antlr-runtime/bin/
# Для этого просто не пишем *.dll и *.exe глобально.
# Можно оставить только для корня, но в целом оставим без глобального запрета.